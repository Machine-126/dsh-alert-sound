{
  "name": "@machine-126/dsh-alert-sound",
  "version": "0.3.16",
  "scripts": {
    "prepublishOnly": "node --check lib/index.mjs && node --check lib/client.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "DSH web GUI notification alerts: distinct synthesized tones or a spoken voice (zh/en) for 'needs approval', 'needs answer', 'output complete', 'error' and an experimental 'stalled' — with per-kind enable/sound/volume/preview, repeat-until-answered, do-not-disturb hours, browser system notifications, read-aloud of the final reply, uploaded custom sounds and an i18n (zh/en) settings page.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Machine-126/dsh-alert-sound.git"
  },
  "homepage": "https://github.com/Machine-126/dsh-alert-sound#readme",
  "bugs": {
    "url": "https://github.com/Machine-126/dsh-alert-sound/issues"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "ROADMAP.md",
    "CHANGELOG.md",
    "CHANGELOG_EN.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "react": "^18.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "notification",
    "sound",
    "chime",
    "voice",
    "web-ui"
  ],
  "license": "MIT"
}
